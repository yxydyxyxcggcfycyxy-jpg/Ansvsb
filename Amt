	local function sendChatMessage()
		if aiSending then return end
		local text = msgInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
		if text == "" then return end
		aiSending = true
		sendBtn.Text = "⏳"
		msgInput.Text = ""
		addBubble("player", text, nil)

		local function finish()
			aiSending = false
			sendBtn.Text = "➤"
		end

		local wantsClose = isCloseTicket(text)
		local wantsOpen = isOpenTicket(text)

		if wantsClose and humanMode then
			askCloseTicket(text)
			finish()
			return
		end

		if wantsOpen and not humanMode then
			askOpenTicket(text)
			finish()
			return
		end

		if humanMode then
			sendSupport(text, function(success)
				finish()
				if not success then addBubble("system", "⚠️ فشل الإرسال", nil) end
			end)
			return
		end

		if not IS_VIP then
			finish()
			addBubble("system", "⚠️ في وضع الزائر اكتب فقط:\n• افتح تكت\n• قفل تكت", nil)
			return
		end

		local stopThink = addThinking()
		askAI(text, function(ok, aiText)
			stopThink()
			finish()
			if not ok then
				addBubble("ai", aiText or "⚠️ خطأ", nil)
				return
			end

			local wantsSupport = aiText:find("%[%[CONTACT_SUPPORT%]%]") ~= nil
			aiText = aiText:gsub("%[%[CONTACT_SUPPORT%]%]", "")
			aiText = aiText:gsub("%[%[.-%]%]", ""):gsub("^%s+", ""):gsub("%s+$", "")

			if aiText ~= "" then
				addBubble("ai", aiText, nil)
			end

			if wantsSupport and not humanMode then
				task.wait(0.5)
				askOpenTicket(text)
			end
		end)
	end

	sendBtn.MouseButton1Click:Connect(sendChatMessage)
	msgInput.FocusLost:Connect(function(enterPressed)
		if enterPressed then sendChatMessage() end
	end)

	task.spawn(function()
		while chatFrame and chatFrame.Parent do
			task.wait(4)
			if not httpRequest then continue end
			local url = KF_MSG_URL .. "?project_id=" .. KF_PROJECT_ID .. "&player_user_id=" .. LocalPlayer.UserId
			if lastSeen then url = url .. "&since=" .. HttpService:UrlEncode(lastSeen) end
			local ok, res = pcall(httpRequest, {
				Url = url, Method = "GET",
				Headers = { ["Authorization"] = "Bearer " .. KF_API_KEY }
			})
			if ok and res then
				local data = decode(res)
				if data and data.messages then
					for _, m in ipairs(data.messages) do
						local msgId = m.id or m.created_at
						if m.created_at then lastSeen = m.created_at end
						if msgId and not shownMessages[msgId] then
							local sender = m.sender or "support"
							if sender ~= "player" and sender ~= "user" then
								addBubble(sender, tostring(m.message or ""), msgId)
								notify("💬 رسالة جديدة", tostring(m.message or ""))
							end
						end
					end
				end
			end
		end
	end)
end

