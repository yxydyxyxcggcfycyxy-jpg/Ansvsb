		if player.Character then
			pcall(function()
				local hum = player.Character:FindFirstChildOfClass("Humanoid")
				if hum then
					hum.WalkSpeed = 16
					hum.JumpPower = 50
					hum.PlatformStand = false
				end
				local root = player.Character:FindFirstChild("HumanoidRootPart")
				if root then root.Anchored = false end
				for _, part in ipairs(player.Character:GetChildren()) do
					if part:IsA("BasePart") then part.Anchored = false end
				end
			end)
		end
	end
end

local function executeKillPhase()
	if _G.AMT_KillPhaseActive then return end
	if _G.AMT_MyRole ~= "Murderer" then return end
	_G.AMT_KillPhaseActive = true
	repeat
		pullAllPlayers()
		task.wait(0.3)
		equipKnife()
		task.wait(0.2)
		attackAll()
		task.wait(0.2)
		killWithRemote()
		task.wait(0.3)
		unfreezeAll()
		local aliveCount = 0
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local hum = player.Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then aliveCount = aliveCount + 1 end
			end
		end
		if aliveCount == 0 then break end
		task.wait(1)
	until not _G.AMT_RoundActive or not IsPlayerAlive()
	_G.AMT_KillPhaseActive = false
end

function farmLoop()
	while _G.AMT_AutoEnabled do
		task.wait(0.1)
		if not IsPlayerAlive() then
			if CurrentTween then CurrentTween:Cancel(); CurrentTween = nil end
			Platform.CFrame = CFrame.new(0, 99999, 0)
			task.wait(1)
		elseif not _G.AMT_RoundActive then
			if CurrentTween then CurrentTween:Cancel(); CurrentTween = nil end
			Platform.CFrame = CFrame.new(0, 99999, 0)
			CollectedCoinObjects = {}
			task.wait(1)
		elseif not _G.AMT_KillPhaseActive then
			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if char and root then
				local targetCoin = GetNearestCoin(root.Position)
				if targetCoin and targetCoin.Parent then
					local tUnder = Vector3.new(targetCoin.Position.X, targetCoin.Position.Y - 10, targetCoin.Position.Z)
					Platform.CFrame = CFrame.new(tUnder.X, tUnder.Y - 2.5, tUnder.Z)
					local dist = (root.Position - tUnder).Magnitude
					local speed = _G.AMT_SpeedValue or 35
					if speed < 5 then speed = 5 end
					if speed > 100 then speed = 100 end
					local tTime = dist / speed
					CurrentTween = TweenService:Create(root, TweenInfo.new(tTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(tUnder)})
					CurrentTween:Play()
					while CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing do
						task.wait()
						if not _G.AMT_AutoEnabled or not IsPlayerAlive() or not _G.AMT_RoundActive then
							if CurrentTween then CurrentTween:Cancel() end
							break
						end
					end
					if _G.AMT_AutoEnabled and IsPlayerAlive() and _G.AMT_RoundActive and targetCoin and targetCoin.Parent then
						local uCF = root.CFrame
						local upT = TweenService:Create(root, TweenInfo.new(0.2, Enum.EasingStyle.Linear), {CFrame = targetCoin.CFrame})
						upT:Play()
						task.wait(0.25)
						pcall(function()
							firetouchinterest(root, targetCoin, 0)
							firetouchinterest(root, targetCoin, 1)
						end)
						CollectedCoinObjects[targetCoin] = true
						local downT = TweenService:Create(root, TweenInfo.new(0.2, Enum.EasingStyle.Linear), {CFrame = uCF})
						downT:Play()
						task.wait(0.25)
					end
				else
					CollectedCoinObjects = {}
					task.wait(0.5)
				end
			end
		end
	end
end

