-- ═══ AI ENGINE ═══
local SYSTEM_PROMPT = [==[
You are "botayf" — a helpful AI assistant.

=== IDENTITY ===
- Your name is botayf
- Reply in the SAME language the user uses
- BE SHORT: 1-3 sentences MAX

=== HUMAN SUPPORT ===
When user asks to talk to support/human/admin or has a problem:
Say a short sentence + END reply with EXACTLY this token: [[CONTACT_SUPPORT]]

=== RULES ===
- NEVER say "I'm a bot" or refuse
]==]

local conversationHistory = {}
local function addToHistory(role, content)
	table.insert(conversationHistory, { role = role, content = content })
	while #conversationHistory > 8 do table.remove(conversationHistory, 1) end
end

local function askAI(text, callback, retryCount)
	retryCount = retryCount or 0
	if not httpRequest then
		if callback then callback(false, "❌ لا يوجد دعم HTTP") end
		return
	end

	local answered = false
	local function safeCb(ok, msg)
		if answered then return end
		answered = true
		if callback then callback(ok, msg) end
	end

	task.delay(35, function() safeCb(false, "⏰ تأخر الرد") end)

	task.spawn(function()
		local messages = {
			{ role = "system", content = SYSTEM_PROMPT },
			{ role = "system", content = charInfoToText() },
		}
		for i = math.max(1, #conversationHistory - 5), #conversationHistory do
			if conversationHistory[i] then
				table.insert(messages, conversationHistory[i])
			end
		end
		table.insert(messages, { role = "user", content = text })

		local body = HttpService:JSONEncode({
			model = AI_MODEL,
			messages = messages,
			temperature = 0.8,
			max_tokens = 500,
		})

		local ok, res = pcall(httpRequest, {
			Url = OPENROUTER_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["Authorization"] = "Bearer " .. OPENROUTER_KEY,
				["HTTP-Referer"] = "https://roblox.com",
				["X-Title"] = "AMT Hub",
			},
			Body = body,
		})

		if not ok or not res or not res.Body then
			if retryCount < 2 then
				task.wait(2 + retryCount)
				return askAI(text, callback, retryCount + 1)
			end
			safeCb(false, "⚠️ فشل الاتصال")
			return
		end

		local okJ, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
		if not okJ or not data then
			if retryCount < 2 then
				task.wait(2)
				return askAI(text, callback, retryCount + 1)
			end
			safeCb(false, "⚠️ استجابة غير صالحة")
			return
		end

		if data.error then
			safeCb(false, "⚠️ " .. (data.error.message or "خطأ"))
			return
		end

		local aiText = data.choices and data.choices[1] and data.choices[1].message and data.choices[1].message.content
		if not aiText or aiText == "" then
			safeCb(false, "⚠️ رد فارغ")
			return
		end

		aiText = aiText:gsub("^%s+", ""):gsub("%s+$", "")
		addToHistory("user", text)
		addToHistory("assistant", aiText)
		safeCb(true, aiText)
	end)
end

