local TICKET_WORDS = { "تكت", "تيكت", "ticket" }
local SUPPORT_WORDS = { "دعم", "سبورت", "support", "بشري", "human", "admin", "owner", "مالك", "مطور", "ادمن" }

local CLOSE_ACTIONS = {
	"قفل", "اقفل", "أقفل", "اغلق", "أغلق", "أنهي", "انهي",
	"close", "end", "done", "resolved", "solved",
	"تم الحل", "خلصت", "انتهيت", "شكرا", "شكراً", "thanks",
}
local OPEN_ACTIONS = {
	"افتح", "فتح", "ابغى", "أبغى", "ابي", "أبي", "اريد", "أريد",
	"open", "new", "create",
	"تواصل", "اتوصل", "أتوصل", "اتكلم", "أتكلم", "كلم",
	"contact", "talk", "need", "help",
	"شكوى", "مشكلة", "problem",
}

local function containsAny(text, list)
	local t = string.lower(text)
	for _, w in ipairs(list) do
		if t:find(string.lower(w), 1, true) then return true end
	end
	return false
end

local function isCloseTicket(text)
	if not containsAny(text, CLOSE_ACTIONS) then return false end
	if containsAny(text, {"تم الحل", "خلصت", "انتهيت", "قفل التكت", "قفل تكت", "اقفل التكت", "اغلق التكت", "close ticket"}) then
		return true
	end
	return containsAny(text, TICKET_WORDS) or containsAny(text, SUPPORT_WORDS)
end

local function isOpenTicket(text)
	if containsAny(text, {"دعم بشري", "الدعم البشري", "human support", "بشري"}) then
		return true
	end
	if containsAny(text, TICKET_WORDS) and containsAny(text, OPEN_ACTIONS) then return true end
	if containsAny(text, SUPPORT_WORDS) and containsAny(text, {"تواصل", "اتوصل", "أتوصل", "كلم", "اتكلم", "contact", "talk"}) then return true end
	if containsAny(text, {"شكوى", "عندي مشكلة", "عندي مشكله", "complaint"}) then return true end
	return false
end

