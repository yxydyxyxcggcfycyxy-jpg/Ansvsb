-- ═══ Character Info ═══
local function getDirection(angle)
	local d = math.deg(angle)
	if d >= -45 and d < 45 then return "شمال"
	elseif d >= 45 and d < 135 then return "شرق"
	elseif d >= 135 or d < -135 then return "جنوب"
	else return "غرب" end
end

local function getCharInfo()
	local info = {}
	local char = LocalPlayer.Character
	if not char then info.status = "لا يوجد شخصية" return info end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		info.health = math.floor(hum.Health)
		info.maxHealth = math.floor(hum.MaxHealth)
		info.state = tostring(hum:GetState())
	end
	if hrp then
		info.position = { x = math.floor(hrp.Position.X), y = math.floor(hrp.Position.Y), z = math.floor(hrp.Position.Z) }
		info.direction = getDirection(hrp.Orientation.Y)
	end
	info.name = LocalPlayer.Name
	info.userId = LocalPlayer.UserId
	if char:FindFirstChildOfClass("Tool") then info.tool = char:FindFirstChildOfClass("Tool").Name end
	return info
end

local function charInfoToText()
	local info = getCharInfo()
	local lines = { "[معلومات اللاعب]", "الاسم: " .. tostring(info.name), "الـID: " .. tostring(info.userId) }
	if info.health then
		table.insert(lines, "الصحة: " .. info.health .. "/" .. info.maxHealth)
		table.insert(lines, "الحالة: " .. tostring(info.state))
	end
	if info.position then
		table.insert(lines, "الموقع: X=" .. info.position.x .. " Y=" .. info.position.y .. " Z=" .. info.position.z)
		table.insert(lines, "الاتجاه: " .. tostring(info.direction))
	end
	if info.tool then table.insert(lines, "الأداة: " .. info.tool) end
	return table.concat(lines, "\n")
end

