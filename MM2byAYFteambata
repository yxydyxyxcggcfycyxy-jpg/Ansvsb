-- SAFE ZONE MONITOR
-- ═══════════════════════════════════════════════════════════════
task.spawn(function()
    while true do
        task.wait(1)
        pcall(function()
            if not A.SafeZoneEnabled or SafeZoneActive or not A.RoundActive then return end
            local role = checkRoleFromTools()
            if role then A.MyRole = role end
            if role == "Murderer" then return end
            if A.MyRole ~= "Innocent" and A.MyRole ~= "Sheriff" then return end
            local cur, tgt = A.CollectedCoins or 0, A.TargetCoins or 50
            if cur < tgt or cur <= 0 then return end
            if hasCoinsLeft() then return end
            goSafeZone()
        end)
    end
end)

