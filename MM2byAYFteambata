    task.spawn(function()
        while frame.Parent do
            task.wait(0.5)
            pcall(function()
                if A.AutoEnabled then
                    if A.RoundActive then
                        farmBtn.Text = "⏹  STOP (FARMING)"
                        farmBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
                    else
                        farmBtn.Text = "🟡 ARMED (WAITING)"
                        farmBtn.BackgroundColor3 = Color3.fromRGB(120, 90, 20)
                    end
                else
                    farmBtn.Text = "▶  ARM FARM"
                    farmBtn.BackgroundColor3 = OR
                end

                local state
                if not A.AutoEnabled then state = "🔴 OFF"
                elseif not A.RoundActive then state = "🟡 ARMED"
                else state = "🟢 FARMING" end

                local role = A.MyRole or "Unknown"
                local icon = "❓"
                if role == "Murderer" then icon = "🔪"
                elseif role == "Sheriff" then icon = "🔫"
                elseif role == "Innocent" then icon = "😇" end

                local tgt = "—"
                pcall(function()
                    local t = getTargets()
                    if #t > 0 then tgt = t[1].Name end
                end)

                local fightMark = A.AutoFight and " ⚔️" or ""
                statusLabel.Text = state .. fightMark .. "\nCoins: " .. A.CollectedCoins .. "/" .. A.TargetCoins
                    .. "\n" .. icon .. " " .. role .. " | 🎯 " .. tgt
            end)
        end
    end)

    return frame
end

