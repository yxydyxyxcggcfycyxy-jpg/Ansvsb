local lastSeen = nil
local primed = false
local shownMessages = {}

local function decodeMsg(res)
	if not res then return nil, "no response" end
	local okJ, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
	if not okJ then return nil, "bad JSON" end
	if res.StatusCode and res.StatusCode >= 400 then return nil, "HTTP " .. res.StatusCode end
	return data
end

local function sendSupport(text, callback)
	if not httpRequest then
		if callback then callback(false, nil) end
		return
	end
	task.spawn(function()
		local ok, res = pcall(httpRequest, {
			Url = MSG_URL, Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["Authorization"] = "Bearer " .. API_KEY,
			},
			Body = HttpService:JSONEncode({
				project_id = PROJECT_ID,
				player_user_id = LocalPlayer.UserId,
				player_name = LocalPlayer.Name,
				message = text,
			}),
		})
		if not ok then if callback then callback(false, nil) end return end
		local data = decodeMsg(res)
		if not data then if callback then callback(false, nil) end return end
		if callback then callback(true, data) end
	end)
end

local function labelSender(sender)
	if sender == "owner" then return "👑 Owner"
	elseif sender == "ai" then return "🤖 AI"
	elseif sender == "player" or sender == "user" then return "👤 You" end
	return "💬 Support"
end

local function pollSupportReplies()
	if not httpRequest then return end
	local url = MSG_URL .. "?project_id=" .. PROJECT_ID .. "&player_user_id=" .. LocalPlayer.UserId
	if lastSeen then url = url .. "&since=" .. HttpService:UrlEncode(lastSeen) end
	local ok, res = pcall(httpRequest, {
		Url = url, Method = "GET",
		Headers = {["Authorization"] = "Bearer " .. API_KEY},
	})
	if not ok then return end
	local data = decodeMsg(res)
	if not data or not data.messages then return end
	for _, m in ipairs(data.messages) do
		lastSeen = m.created_at
		local msgId = m.id or m.created_at
		if msgId and not shownMessages[msgId] and primed then
			shownMessages[msgId] = true
			notify(labelSender(m.sender), tostring(m.message))
			if supChatFrame and supChatFrame.Visible and addSupChatBubble then
				addSupChatBubble(m.sender or "support", m.message or "", msgId)
			end
		elseif msgId then
			shownMessages[msgId] = true
		end
	end
	primed = true
end

