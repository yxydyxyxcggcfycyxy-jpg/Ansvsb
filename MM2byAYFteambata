local function askAI(text, callback)
	if not httpRequest then callback(false, "❌ لا يوجد HTTP") return end
	local answered = false
	local function safe(ok, msg)
		if answered then return end
		answered = true
		callback(ok, msg)
	end
	task.delay(40, function() safe(false, "⏰ تأخر الرد") end)

	task.spawn(function()
		local messages = {{role = "system", content = SYSTEM_PROMPT}}
		for _, h in ipairs(aiHistory) do table.insert(messages, h) end
		table.insert(messages, {role = "user", content = text})

		local function finish(aiText)
			if not aiText or aiText == "" then return false end
			aiText = tostring(aiText):gsub("^%s+", ""):gsub("%s+$", "")
			aiText = aiText:gsub("%[%[.-%]%]", "")
			if hasBlocked(aiText) or aiText == "" then return false end
			table.insert(aiHistory, {role = "user", content = text})
			table.insert(aiHistory, {role = "assistant", content = aiText})
			while #aiHistory > 6 do table.remove(aiHistory, 1) end
			safe(true, aiText)
			return true
		end

		if finish(tryLLM7(messages)) then return end
		task.wait(0.2)
		if finish(tryKeylessAI(messages)) then return end
		task.wait(0.2)
		if finish(tryPollinationsPOST(messages)) then return end
		task.wait(0.2)
		if finish(tryPollinationsGET(text)) then return end
		task.wait(0.2)
		if finish(tryKilo(messages)) then return end
		task.wait(0.2)
		if finish(tryUncloseai(messages)) then return end
		safe(false, "⚠️ كل المزودين مشغولين")
	end)
end

