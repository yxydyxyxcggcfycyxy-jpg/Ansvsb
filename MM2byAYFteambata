local aiHistory = {}
local BLOCKED = {"user not found", "not found", "error", "failed", "invalid", "404", "500", "unauthorized", "rate limit"}

local function hasBlocked(t)
	if not t then return false end
	local l = string.lower(tostring(t))
	for _, w in ipairs(BLOCKED) do
		if l:find(w, 1, true) then return true end
	end
	return false
end

local function parseOpenAI(raw)
	if not raw then return nil end
	local okJ, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if okJ and data then
		if data.choices and data.choices[1] and data.choices[1].message then
			return data.choices[1].message.content
		elseif data.content then return data.content
		elseif data.response then return data.response end
	end
	return nil
end

local function tryLLM7(messages)
	local ok, res = pcall(httpRequest, {
		Url = "https://api.llm7.io/v1/chat/completions", Method = "POST",
		Headers = {["Content-Type"] = "application/json", ["Authorization"] = "Bearer unused"},
		Body = HttpService:JSONEncode({model = "default", messages = messages, max_tokens = 300}),
	})
	if not ok or not res or not res.Body then return nil end
	if res.StatusCode and res.StatusCode >= 400 then return nil end
	local raw = tostring(res.Body)
	if hasBlocked(raw) then return nil end
	return parseOpenAI(raw)
end

