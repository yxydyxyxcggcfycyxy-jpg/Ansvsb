-- COMBAT HELPERS
-- ═══════════════════════════════════════════════════════════════
local function pullAll()
    local ch = LP.Character
    if not ch then return end
    local r = ch:FindFirstChild("HumanoidRootPart")
    if not r then return end
    local pos = r.Position
    local lv = r.CFrame.LookVector
    local rv = r.CFrame.RightVector
    local i = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local tr = p.Character:FindFirstChild("HumanoidRootPart")
            if tr then
                local row = math.floor(i / 4)
                local col = i % 4
                local tp = pos + (lv * (row * 1.2 + 2)) + (rv * ((col - 1.5) * 1.2))
                pcall(function()
                    tr.CFrame = CFrame.new(tp, pos)
                    tr.Anchored = true
                    local h = p.Character:FindFirstChildOfClass("Humanoid")
                    if h then
                        h.WalkSpeed = 0
                        h.JumpPower = 0
                        h.PlatformStand = true
                    end
                    for _, pt in ipairs(p.Character:GetChildren()) do
                        if pt:IsA("BasePart") then pt.Anchored = true end
                    end
                end)
                i = i + 1
            end
        end
    end
end

local function equipK()
    pcall(function()
        local ch = LP.Character
        if not ch then return end
        local h = ch:FindFirstChildOfClass("Humanoid")
        local bp = LP:FindFirstChildOfClass("Backpack")
        if not h then return end
        if ch:FindFirstChildOfClass("Tool") then
            VU:CaptureController()
            VU:ClickButton1(Vector2.new(500, 500))
            return
        end
        if bp then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") then
                    local n = tool.Name:lower()
                    if n:find("knife") or n:find("sword") or n:find("blade") then
                        pcall(function() h:EquipTool(tool) end)
                        task.wait(0.08)
                        VU:CaptureController()
                        VU:ClickButton1(Vector2.new(500, 500))
                        return
                    end
                end
            end
            local firstTool = bp:FindFirstChildOfClass("Tool")
            if firstTool then
                pcall(function() h:EquipTool(firstTool) end)
                task.wait(0.08)
                VU:CaptureController()
                VU:ClickButton1(Vector2.new(500, 500))
            end
        end
    end)
end

local function atkAll()
    for i = 1, 15 do
        pcall(function()
            VU:CaptureController()
            VU:ClickButton1(Vector2.new(500, 500))
        end)
        task.wait(0.05)
    end
end

local function killRem()
    if not killEvent then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            pcall(function()
                killEvent:FireServer(p.Name, OR)
                killEvent:FireServer(p.Name)
            end)
        end
    end
end

function unfreezeAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            pcall(function()
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h then
                    h.WalkSpeed = 16
                    h.JumpPower = 50
                    h.PlatformStand = false
                end
                local r = p.Character:FindFirstChild("HumanoidRootPart")
                if r then r.Anchored = false end
                for _, pt in ipairs(p.Character:GetChildren()) do
                    if pt:IsA("BasePart") then pt.Anchored = false end
                end
            end)
        end
    end
end

