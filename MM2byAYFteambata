-- ROLE DETECT
-- ═══════════════════════════════════════════════════════════════
local function applyRole(n, i)
    if not n then return end
    RoleData[n] = i or { Role = "Innocent" }
    if n == LP.Name then A.MyRole = (i and i.Role) or "Innocent" end
end

local function detectR(p)
    local ch = p.Character
    if not ch then return nil end
    local t = ch:FindFirstChildOfClass("Tool")
    if not t then return nil end
    local n = t.Name:lower()
    if n:find("knife") or n:find("sword") or n:find("blade") then return "Murderer" end
    if n:find("gun") or n:find("revolver") or n:find("pistol") then return "Sheriff" end
end

task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(function()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then
                    local ex = RoleData[p.Name]
                    if not ex or not ex.Role or ex.Role == "Unknown" then
                        local r = detectR(p)
                        if r then RoleData[p.Name] = { Role = r }
                        elseif A.RoundActive then RoleData[p.Name] = { Role = "Innocent" } end
                    end
                end
            end
            if A.RoundActive then
                local mc = LP.Character
                if mc then
                    local mt = mc:FindFirstChildOfClass("Tool")
                    if mt then
                        local n = mt.Name:lower()
                        if n:find("knife") or n:find("sword") then A.MyRole = "Murderer"
                        elseif n:find("gun") or n:find("revolver") then A.MyRole = "Sheriff" end
                    end
                end
            end
        end)
    end
end)

-- ═══════════════════════════════════════════════════════════════
-- 👁️ ESP ROLES
-- ═══════════════════════════════════════════════════════════════
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "AMT_ESP"
ESPFolder.Parent = WS

local function roleColor(r)
    if r == "Murderer" then return Color3.fromRGB(255, 50, 50)
    elseif r == "Sheriff" then return Color3.fromRGB(50, 180, 255)
    elseif r == "Innocent" then return Color3.fromRGB(80, 220, 120) end
    return Color3.fromRGB(180, 180, 180)
end

local function roleTag(r)
    if r == "Murderer" then return "🔪"
    elseif r == "Sheriff" then return "🔫"
    elseif r == "Innocent" then return "😇" end
    return "❓"
end

local function createESP(p)
    if p == LP or ESPObj[p] then return end
    local h = Instance.new("Highlight")
    h.FillTransparency = 0.5
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = ESPFolder
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 200, 0, 40)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 500
    bb.Parent = ESPFolder
    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.new(1, 0, 1, 0)
    tl.BackgroundTransparency = 1
    tl.TextSize = 14
    tl.Font = Enum.Font.GothamBold
    tl.TextStrokeTransparency = 0
    tl.TextStrokeColor3 = Color3.new(0, 0, 0)
    tl.Parent = bb
    ESPObj[p] = { h = h, b = bb, t = tl }
end

local function removeESP(p)
    if ESPObj[p] then
        pcall(function()
            ESPObj[p].h:Destroy()
            ESPObj[p].b:Destroy()
        end)
        ESPObj[p] = nil
    end
end

local function updateESP()
    for p, o in pairs(ESPObj) do
        if not p.Parent then
            removeESP(p)
        else
            local ch = p.Character
            local role = RoleData[p.Name] and RoleData[p.Name].Role or "Unknown"
            if A.ESPEnabled and ch and ch:FindFirstChild("HumanoidRootPart") then
                local col = roleColor(role)
                o.h.Adornee = ch
                o.h.FillColor = col
                o.h.OutlineColor = col
                o.h.Enabled = true
                o.b.Adornee = ch.HumanoidRootPart
                o.b.Enabled = true
                o.t.Text = roleTag(role) .. " " .. p.Name
                o.t.TextColor3 = col
            else
                o.h.Enabled = false
                o.b.Enabled = false
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.2)
        pcall(updateESP)
    end
end)

