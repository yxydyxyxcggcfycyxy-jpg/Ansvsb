-- ═══════════════════════════════════════════════════════════════
-- FARM LOOP
-- ═══════════════════════════════════════════════════════════════
local function farmLoop()
    while A.FarmEnabled do
        task.wait(0.03)
        if SafeZoneActive then task.wait(0.4) continue end
        if A.CurrentKillTarget then task.wait(0.15) continue end
        if tick() - LastFailedClear > 8 then
            LastFailedClear = tick()
            FailedCoins = {}
            LastCoinRefresh = 0
        end
        if not A.RoundActive then
            if VelGuard then stopVG() end
            if CurTween then CurTween:Cancel() CurTween = nil end
            task.wait(0.5)
            continue
        end
        if not VelGuard then startVG() end
        local ch = LP.Character
        local r = ch and ch:FindFirstChild("HumanoidRootPart")
        local h = ch and ch:FindFirstChildOfClass("Humanoid")
        if not r or not h or h.Health <= 0 or tick() - LastRespawn < 3 then
            if CurTween then CurTween:Cancel() CurTween = nil end
            task.wait(0.4)
            continue
        end
        local sp = math.clamp(A.SpeedValue or 16, A.SpeedMin or 5, A.SpeedMax or 60)
        local tc = nearCoin(r.Position)
        if not (tc and tc.Parent) then task.wait(A.CollectDelay) continue end
        local dist = (tc.Position - r.Position).Magnitude
        if dist > (A.MaxCoinDistance or 300) then
            FailedCoins[tc] = true
            LastCoinRefresh = 0
            task.wait(0.05)
            continue
        end
        local offset = math.clamp(A.CoinOffset or 4, 1, 10)
        local under = Vector3.new(tc.Position.X, tc.Position.Y - offset, tc.Position.Z)
        local vertMult = A.VerticalSpeedMult or 1.5
        local holdAtCoin = A.CoinHoldTime or 0.05
        local STEPS = {
            { pos = under, spd = sp, touch = false, hold = 0 },
            { pos = tc.Position, spd = sp * vertMult, touch = true, hold = holdAtCoin },
            { pos = under, spd = sp * vertMult, touch = false, hold = 0 },
        }
        for _, s in ipairs(STEPS) do
            if not A.FarmEnabled or not isAlive() or not A.RoundActive or SafeZoneActive or A.CurrentKillTarget then break end
            local d = (r.Position - s.pos).Magnitude
            local dur = math.max(0.03, d / s.spd)
            if CurTween then CurTween:Cancel() end
            CurTween = TS:Create(r, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = CFrame.new(s.pos) })
            CurTween:Play()
            task.wait(dur + 0.01)
            if s.touch and tc and tc.Parent then
                local before = A.CollectedCoins or 0
                pcall(function()
                    firetouchinterest(r, tc, 0)
                    firetouchinterest(r, tc, 1)
                end)
                CCO[tc] = true
                task.wait(0.03)
                if tc and tc.Parent and (A.CollectedCoins or 0) == before then
                    FailedCoins[tc] = true
                else
                    if UiCallbacks.onCoin then UiCallbacks.onCoin() end
                end
            end
            if s.hold and s.hold > 0 then task.wait(s.hold) end
        end
        task.wait(A.CollectDelay)
    end
    stopVG()
end

-- ═══════════════════════════════════════════════════════════════
-- PULL ALL → IN FRONT
-- ═══════════════════════════════════════════════════════════════
local function pullAllInFront()
    local ch = LP.Character
    local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
    if not myRoot then return {} end
    local captured = {}
    local alivePlayers = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local tr = p.Character:FindFirstChild("HumanoidRootPart")
            local th = p.Character:FindFirstChildOfClass("Humanoid")
            if tr and th and th.Health > 0 then
                table.insert(alivePlayers, { player = p, root = tr, hum = th })
            end
        end
    end
    if #alivePlayers == 0 then return {} end
    local lookVec = myRoot.CFrame.LookVector
    lookVec = Vector3.new(lookVec.X, 0, lookVec.Z)
    if lookVec.Magnitude < 0.1 then
        lookVec = Vector3.new(0, 0, -1)
    else
        lookVec = lookVec.Unit
    end
    pcall(function()
        myRoot.CFrame = CFrame.new(myRoot.Position, myRoot.Position + lookVec)
    end)
    local frontDist = math.clamp(A.KillFrontDist or 3, 2, 6)
    local frontPos = myRoot.Position + lookVec * frontDist
    local baseRad = math.clamp(A.KillFrontRadius or 1.0, 0.5, 2.5)
    local rad = math.clamp(baseRad + #alivePlayers * 0.15, baseRad, 2.5)
    for i, c in ipairs(alivePlayers) do
        local angle = ((i - 1) / math.max(#alivePlayers, 1)) * math.pi * 2
        local pos = frontPos + Vector3.new(math.cos(angle) * rad, 0, math.sin(angle) * rad)
        pcall(function()
            c.root.Anchored = true
            c.root.CFrame = CFrame.new(pos, pos - lookVec * 5)
            c.hum.WalkSpeed = 0
            c.hum.JumpPower = 0
            c.hum.PlatformStand = true
            for _, pt in ipairs(c.player.Character:GetChildren()) do
                if pt:IsA("BasePart") then pt.Anchored = true end
            end
        end)
        table.insert(captured, c)
    end
    return captured
end

local function equipKnife()
