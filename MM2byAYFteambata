		Headers = {["Content-Type"] = "application/json", ["Accept"] = "text/plain"},
		Body = HttpService:JSONEncode({model = "openai", messages = messages}),
	})
	if not ok or not res or not res.Body then return nil end
	if res.StatusCode and res.StatusCode >= 400 then return nil end
	local raw = tostring(res.Body)
	if hasBlocked(raw) then return nil end
	return parseOpenAI(raw)
end

local function tryPollinationsGET(text)
	local url = "https://text.pollinations.ai/" .. HttpService:UrlEncode(text)
		.. "?model=openai&seed=" .. math.random(1, 999999)
	local ok, res = pcall(httpRequest, {Url = url, Method = "GET", Headers = {["Accept"] = "text/plain"}})
	if not ok or not res or not res.Body then return nil end
	if #res.Body < 3 then return nil end
	local txt = tostring(res.Body)
	if hasBlocked(txt) then return nil end
	return txt
end

local function tryKilo(messages)
	local ok, res = pcall(httpRequest, {
		Url = "https://api.kilo.ai/api/gateway/chat/completions", Method = "POST",
		Headers = {["Content-Type"] = "application/json", ["Authorization"] = "Bearer unused"},
		Body = HttpService:JSONEncode({model = "gpt-4o-mini", messages = messages, max_tokens = 300}),
	})
	if not ok or not res or not res.Body then return nil end
	if res.StatusCode and res.StatusCode >= 400 then return nil end
	local raw = tostring(res.Body)
	if hasBlocked(raw) then return nil end
	return parseOpenAI(raw)
end

local function tryUncloseai(messages)
	local ok, res = pcall(httpRequest, {
		Url = "https://api.uncloseai.com/v1/chat/completions", Method = "POST",
		Headers = {["Content-Type"] = "application/json"},
		Body = HttpService:JSONEncode({model = "gpt-4o-mini", messages = messages}),
	})
	if not ok or not res or not res.Body then return nil end
	if res.StatusCode and res.StatusCode >= 400 then return nil end
	local raw = tostring(res.Body)
	if hasBlocked(raw) then return nil end
	return parseOpenAI(raw)
end

local function askAI(text, callback)
	if not httpRequest then callback(false, "❌ لا يوجد HTTP") return end
	local answered = false
	local function safe(ok, msg)
		if answered then return end
		answered = true
		callback(ok, msg)
	end
	task.delay(40, function() safe(false, "⏰ تأخر الرد") end)

	task.spawn(function()
		local messages = {{role = "system", content = SYSTEM_PROMPT}}
		for _, h in ipairs(aiHistory) do table.insert(messages, h) end
		table.insert(messages, {role = "user", content = text})

		local function finish(aiText)
			if not aiText or aiText == "" then return false end
			aiText = tostring(aiText):gsub("^%s+", ""):gsub("%s+$", "")
			aiText = aiText:gsub("%[%[.-%]%]", "")
			if hasBlocked(aiText) or aiText == "" then return false end
			table.insert(aiHistory, {role = "user", content = text})
			table.insert(aiHistory, {role = "assistant", content = aiText})
			while #aiHistory > 6 do table.remove(aiHistory, 1) end
			safe(true, aiText)
			return true
		end

		if finish(tryLLM7(messages)) then return end
		task.wait(0.2)
		if finish(tryKeylessAI(messages)) then return end
		task.wait(0.2)
		if finish(tryPollinationsPOST(messages)) then return end
		task.wait(0.2)
		if finish(tryPollinationsGET(text)) then return end
		task.wait(0.2)
		if finish(tryKilo(messages)) then return end
		task.wait(0.2)
		if finish(tryUncloseai(messages)) then return end
		safe(false, "⚠️ كل المزودين مشغولين، جرب بعد لحظات")
	end)
end

local function sendSupport(text, callback)
	if not httpRequest then if callback then callback(false) end return end
	task.spawn(function()
		local ok, res = pcall(httpRequest, {
			Url = KF_MSG_URL, Method = "POST",
			Headers = {["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. KF_API_KEY},
			Body = HttpService:JSONEncode({
				project_id = KF_PROJECT_ID,
				player_user_id = tostring(LocalPlayer.UserId),
				player_name = LocalPlayer.Name,
				message = text,
			}),
		})
		if not ok or not res then if callback then callback(false) end return end
		if res.StatusCode and res.StatusCode >= 400 then if callback then callback(false) end return end
		if callback then callback(true) end
	end)
end

