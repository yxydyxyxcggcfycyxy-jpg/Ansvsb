  elseif not A.RoundActive then
   if CurTween then CurTween:Cancel() CurTween=nil end
   Plat.CFrame=CFrame.new(0,99999,0)
   CCO={}
   task.wait(1)
  else
   local ch=LP.Character
   local r=ch and ch:FindFirstChild("HumanoidRootPart")
   if ch and r then
    local tc=nearCoin(r.Position)
    if tc and tc.Parent then
     local tu=Vector3.new(tc.Position.X,tc.Position.Y-10,tc.Position.Z)
     Plat.CFrame=CFrame.new(tu.X,tu.Y-2.5,tu.Z)
     local d=(r.Position-tu).Magnitude
     local sp=math.clamp(A.SpeedValue or 35,5,100)
     CurTween=TS:Create(r,TweenInfo.new(d/sp,Enum.EasingStyle.Linear),{CFrame=CFrame.new(tu)})
     CurTween:Play()
     while CurTween and CurTween.PlaybackState==Enum.PlaybackState.Playing do
      task.wait()
      if not A.AutoEnabled or not isAlive() or not A.RoundActive then
       if CurTween then CurTween:Cancel() end
       break
      end
     end
     if A.AutoEnabled and isAlive() and A.RoundActive and tc and tc.Parent then
      local uC=r.CFrame
      local uT=TS:Create(r,TweenInfo.new(0.2,Enum.EasingStyle.Linear),{CFrame=tc.CFrame})
      uT:Play() task.wait(0.25)
      pcall(function() firetouchinterest(r,tc,0) firetouchinterest(r,tc,1) end)
      CCO[tc]=true
      local dT=TS:Create(r,TweenInfo.new(0.2,Enum.EasingStyle.Linear),{CFrame=uC})
      dT:Play() task.wait(0.25)
     end
    else
     CCO={}
     task.wait(0.5)
    end
   end
  end
 end
end

