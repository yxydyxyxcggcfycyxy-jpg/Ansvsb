  local msgs={{role="system",content=AIP}} for _,h in ipairs(aiH) do table.insert(msgs,h) end table.insert(msgs,{role="user",content=t})
  local function fin(x)
   if not x or x=="" then return false end
   x=tostring(x):gsub("^%s+",""):gsub("%s+$","")
   if hB(x) or x=="" then return false end
   table.insert(aiH,{role="user",content=t}) table.insert(aiH,{role="assistant",content=x})
