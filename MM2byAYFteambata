					local rt = ""
					if _G.AMT.ESPRoles and role then
						if role == "Murderer" then rt = "🔪 "
						elseif role == "Sheriff" then rt = "🔫 "
						elseif role == "Innocent" then rt = "👤 "
						else rt = "❔ " end
