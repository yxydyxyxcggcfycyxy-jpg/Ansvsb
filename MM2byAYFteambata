local function applyRole(n, i)
    if not n then return end
    RoleData[n] = i or { Role = "Innocent" }
    if n == LP.Name then A.MyRole = (i and i.Role) or "Innocent" end
end

task.spawn(function()
    while true do
        task.wait(0.4)
        pcall(function()
            if A.RoundActive and (A.MyRole == "Unknown" or A.MyRole == "Innocent") then
                local role = checkRoleFromTools()
                if role then A.MyRole = role
                elseif tick() - (A.RoundStartTime or 0) > 6 and A.MyRole == "Unknown" then
                    A.MyRole = "Innocent"
                end
            end
        end)
    end
end)

