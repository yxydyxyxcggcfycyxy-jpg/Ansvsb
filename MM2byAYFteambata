		_G.AMT.AutoEngageKilling = false
		CollectedCoinObjects = {}
	end)
end)

pcall(function()
	RS.Remotes.Gameplay.CoinCollected.OnClientEvent:Connect(function(coinType, collected, total, extra)
		_G.AMT.CollectedCoins = collected
		_G.AMT.TargetCoins = total
	end)
end)

pcall(function()
	RS.Remotes.Gameplay.RoundEndFade.OnClientEvent:Connect(function()
		_G.AMT.RoundActive = false
		RoleData = {}
		_G.AMT.MyRole = "Unknown"
		_G.AMT.AutoEngageKilled = false
		_G.AMT.AutoEngageKilling = false
		if CurrentTween then CurrentTween:Cancel(); CurrentTween = nil end
		Platform.CFrame = CFrame.new(0, 99999, 0)
		SafeBlock.Position = Vector3.new(0, 99999, 0)
		unfreezeAll()
	end)
end)

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.RightShift then
		_G.AMT.AutoEnabled = not _G.AMT.AutoEnabled
		if _G.AMT.AutoEnabled then
			_G.AMT.AutoEngageKilling = false
			_G.AMT.AutoEngageKilled = false
			SafeBlock.Position = Vector3.new(0, 99999, 0)
			task.spawn(farmLoop)
			notify("✅", "الفارم شغال")
		else
			if CurrentTween then CurrentTween:Cancel(); CurrentTween = nil end
			Platform.CFrame = CFrame.new(0, 99999, 0)
			unfreezeAll()
			notify("🔴", "توقف")
		end
	end
end)

