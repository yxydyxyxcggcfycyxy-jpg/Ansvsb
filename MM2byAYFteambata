-- ═══════════════════════════════════════════════════════════════
-- COIN CACHE
-- ═══════════════════════════════════════════════════════════════
local CCO, RoleData = {}, {}
local CurTween, VelGuard = nil, nil
local LastCoinRefresh = 0
local CoinCache, CoinCacheTime = {}, 0
local FailedCoins, LastFailedClear = {}, 0
local LastRespawn, KillLoopRunning = 0, false

local function refreshCoinCache()
    if tick() - LastCoinRefresh < 1 then return end
    LastCoinRefresh = tick()
    local newCache = {}
    local ok, desc = pcall(function() return WS:GetDescendants() end)
    if not ok or not desc then return end
    for i = 1, #desc do
        local v = desc[i]
        if v:IsA("BasePart") and not CCO[v] and not FailedCoins[v] then
            local n = v.Name
            if n == "Coin_Server" or n == "Coin" or n == "Coin_Client"
                or n:lower():find("coin", 1, true) then
                newCache[#newCache + 1] = v
            end
        end
    end
    CoinCache = newCache
    CoinCacheTime = tick()
end

local function isCoinValid(v)
    if not v or not v.Parent then return false end
    if CCO[v] or FailedCoins[v] then return false end
    if v.Transparency >= 1 then return false end
    if v.CanCollide == false and v.CanTouch == false then return false end
    return true
end

local function nearCoin(pos)
    if tick() - CoinCacheTime > 1 then refreshCoinCache() end
    if #CoinCache == 0 then return nil end
    local best, bestDist = nil, math.huge
    local newCache = {}
    for i = 1, #CoinCache do
        local v = CoinCache[i]
        if isCoinValid(v) then
            local d = (v.Position - pos).Magnitude
            if d < bestDist then bestDist = d best = v end
            newCache[#newCache + 1] = v
        end
    end
    CoinCache = newCache
    return best
end

local function hasCoinsLeft()
    local ok, desc = pcall(function() return WS:GetDescendants() end)
    if not ok or not desc then return false end
    for i = 1, #desc do
        local v = desc[i]
        if v:IsA("BasePart") and v.Parent and v.Transparency < 1 then
            if not FailedCoins[v] and not CCO[v] then
                local n = v.Name
                if n == "Coin_Server" or n == "Coin" or n == "Coin_Client"
                    or n:lower():find("coin", 1, true) then
                    return true
                end
            end
        end
    end
    return false
end

