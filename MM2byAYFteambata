-- IDLE HOLD
-- ═══════════════════════════════════════════════════════════════
local IdleHold = nil
local function holdPlayer()
    local ch = LP.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if IdleHold then pcall(function() IdleHold:Destroy() end) IdleHold = nil end
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    if hrp.Position.Y < -100 then
        pcall(function() hrp.CFrame = CFrame.new(0, 100, 0) end)
    end
    local targetPos = hrp.Position
    pcall(function()
        local rc = RaycastParams.new()
        rc.FilterDescendantsInstances = {ch}
        rc.FilterType = Enum.RaycastFilterType.Exclude
        local ray = WS:Raycast(hrp.Position + Vector3.new(0, 2, 0), Vector3.new(0, -300, 0), rc)
        if ray and ray.Position.Y > -100 then
            targetPos = Vector3.new(hrp.Position.X, ray.Position.Y + 3.5, hrp.Position.Z)
            hrp.CFrame = CFrame.new(targetPos)
        end
    end)
    local bp = Instance.new("BodyPosition")
    bp.MaxForce = Vector3.new(0, 100000, 0)
    bp.Position = targetPos
    bp.P, bp.D = 5000, 500
    bp.Parent = hrp
    IdleHold = bp
end
local function releasePlayer()
    if IdleHold then pcall(function() IdleHold:Destroy() end) IdleHold = nil end
end

