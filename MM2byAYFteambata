	while true do
		task.wait(0.5)
		pcall(function()
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer then
					local existing = RoleData[p.Name]
					if not existing or not existing.Role or existing.Role == "Unknown" then
						local role = detectRoleFromTools(p) or detectRoleFromAppearance(p)
						if role then
							RoleData[p.Name] = {Role = role}
						elseif _G.AMT.RoundActive then
							RoleData[p.Name] = {Role = "Innocent"}
