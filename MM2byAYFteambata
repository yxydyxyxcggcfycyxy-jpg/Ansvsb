-- 🎯 استقبال الرسائل الجديدة
local function getNewPlayerMessages()
	if not httpRequest then return end
	local url = CHAT_URL .. "/messages?project_id=" .. PROJECT_ID .. "&user_id=" .. LocalPlayer.UserId .. "&key=" .. HttpService:UrlEncode(Key)
	if lastChatId then
		url = url .. "&last_message_id=" .. lastChatId
	end
	local ok, res = pcall(httpRequest, {
		Url = url, Method = "GET",
		Headers = { ["Authorization"] = "Bearer " .. API_KEY },
	})
	if not ok then return end
	local data = decodeMsg(res)
	if not data then return end

	local first = (lastChatId == nil)
	for _, m in ipairs(data.messages or {}) do
		local msgId = tostring(m.id or m.created_at or tick())
		if pcChatSeen[msgId] then continue end
		pcChatSeen[msgId] = true

		if not first and m.from_user_id ~= LocalPlayer.UserId then
			local isDM = (m.to_user_id ~= nil and m.to_user_id ~= 0)
			local tag = isDM and "📩 DM من " or "💬 رسالة من "
			notify(tag .. tostring(m.from_username), tostring(m.message))
			if pcChatFrame and pcChatFrame.Visible and addPCChatBubble then
				addPCChatBubble("them", tostring(m.from_username), tostring(m.message) .. (isDM and " (خاص)" or ""), msgId)
			end
		end
	end
	lastChatId = data.last_message_id
end

