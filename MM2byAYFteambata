    if not mc then return nil end
    local mt = mc:FindFirstChildOfClass("Tool")
    if mt then
        local n = mt.Name:lower()
        if n:find("knife") or n:find("sword") or n:find("blade") or n:find("dagger") then return "Murderer" end
        if n:find("gun") or n:find("revolver") or n:find("pistol") then return "Sheriff" end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("knife") or n:find("sword") or n:find("blade") or n:find("dagger") then return "Murderer" end
                if n:find("gun") or n:find("revolver") or n:find("pistol") then return "Sheriff" end
