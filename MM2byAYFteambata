	local function sendMsg()
		if pcSending then return end
		local text = input.Text:gsub("^%s+", ""):gsub("%s+$", "")
		if text == "" then return end
		local targetId = tonumber(idInput.Text)
		pcSending = true
		sendBtn.Text = "⏳"
		input.Text = ""
		addPCChatBubble("me", LocalPlayer.Name, text .. (targetId and (" → " .. targetId) or " (عام)"), nil)

		sendPlayerMessage(targetId, text, function(ok, err)
			pcSending = false
			sendBtn.Text = "➤"
			if ok then
				addPCChatBubble("system", "", "✅ تم الإرسال" .. (targetId and " (خاص)" or " (عام)"), nil)
			else
				addPCChatBubble("system", "", "⚠️ فشل: " .. tostring(err), nil)
			end
		end)
	end

	sendBtn.MouseButton1Click:Connect(sendMsg)
	input.FocusLost:Connect(function(e) if e then sendMsg() end end)

	addPCChatBubble("system", "", "أهلاً " .. LocalPlayer.Name .. " 👋\nUserId فاضي = غرفة عامة | UserId موجود = رسالة خاصة", nil)
