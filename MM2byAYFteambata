	RankTab:Section({ Title = "🎯 تعيين رتبة" })

	local targetName = ""
	local selectedRank = "VIP"

	RankTab:Input({
		Title = "👤 اسم اللاعب",
		Placeholder = "PlayerName",
		Callback = function(t) targetName = t end
	})

	RankTab:Dropdown({
		Title = "🏆 الرتبة",
		Values = IS_OWNER and {"Owner", "CoOwner", "Elite", "Helper", "BlackMark", "Admin", "VIP", "Member"} or {"Elite", "Helper", "BlackMark", "Admin", "VIP", "Member"},
		Value = "VIP",
		Callback = function(v) selectedRank = v end
	})

	RankTab:Button({
		Title = "✅ تعيين الرتبة",
		Icon = "check",
		Callback = function()
			if targetName == "" then notify("⚠️", "اكتب اسم اللاعب") return end
			if not canManage(LocalPlayer.Name, selectedRank) then
				notify("🚫", "ما عندك صلاحية تعطي هذه الرتبة")
				return
			end
			if selectedRank ~= "Owner" and getRank(targetName) == "Owner" and not IS_OWNER then
				notify("🚫", "ما تقدر تلمس Owner")
				return
			end
			RANKS[targetName] = selectedRank
			saveRanks()
			local t = Players:FindFirstChild(targetName)
			if t then
				removeHeadTag(t)
				task.wait(0.2)
				createHeadTag(t)
			end
			refreshHeadTags()
			notify("👑", targetName .. " → " .. selectedRank)
			SendWebhook("👑 تعيين رتبة",
				"**Admin:** " .. LocalPlayer.Name .. " (" .. MY_RANK .. ")\n**Target:** " .. targetName .. "\n**Rank:** " .. selectedRank,
				15844367)
		end
	})

	RankTab:Divider()

	RankTab:Section({ Title = "🔻 تنزيل / حذف رتبة" })
	RankTab:Button({
		Title = "🗑️ حذف الرتبة (يرجع Member)",
		Icon = "trash-2",
		Callback = function()
			if targetName == "" then notify("⚠️", "اكتب اسم") return end
			if not canManage(LocalPlayer.Name, getRank(targetName)) then
				notify("🚫", "ما تقدر تنزل شخص أقوى منك")
				return
			end
			if getRank(targetName) == "Owner" and not IS_OWNER then
				notify("🚫", "ما تقدر تلمس Owner")
				return
			end
			RANKS[targetName] = "Member"
			saveRanks()
			local t = Players:FindFirstChild(targetName)
			if t then removeHeadTag(t) end
			refreshHeadTags()
			notify("🔻", targetName .. " صار Member")
		end
	})

	RankTab:Button({
		Title = "🚫 طرد من السكربت + السيرفر",
		Icon = "ban",
		Callback = function()
			if targetName == "" then notify("⚠️", "اكتب اسم") return end
			if not canManage(LocalPlayer.Name, getRank(targetName)) then
				notify("🚫", "ما تقدر تطرد شخص أقوى منك")
				return
			end
			if getRank(targetName) == "Owner" and not IS_OWNER then
				notify("🚫", "ما تقدر تطرد Owner")
				return
			end
			KICKED_USERS[targetName] = {
				reason = "من الإدارة",
				by = LocalPlayer.Name,
				time = os.date("%Y-%m-%d %H:%M:%S"),
			}
			saveKicked()
			local t = Players:FindFirstChild(targetName)
			if t then pcall(function() t:Kick("🚫 تم طردك من AMT") end) end
			notify("🚫", "تم الطرد")
		end
	})

	RankTab:Divider()
	RankTab:Section({ Title = "📋 قائمة الرتب النشطة" })

	local RankList = RankTab:Paragraph({Title = "👥", Desc = "..."})
	task.spawn(function()
		while true do
			task.wait(2)
			local lines = {}
			local sorted = {}
			for name, rank in pairs(RANKS) do
				table.insert(sorted, {name = name, rank = rank, power = RANK_POWER[rank] or 0})
			end
			table.sort(sorted, function(a, b) return a.power > b.power end)
			for _, entry in ipairs(sorted) do
				local rd = RANK_DATA[entry.rank]
				local online = Players:FindFirstChild(entry.name) and " 🟢" or " ⚪"
				table.insert(lines, (rd and rd.emoji or "❔") .. " " .. entry.rank .. " | " .. entry.name .. online)
			end
			pcall(function()
				RankList:SetDesc(#lines == 0 and "لا يوجد" or table.concat(lines, "\n"))
			end)
		end
	end)

	if IS_OWNER then
		RankTab:Divider()
		RankTab:Section({ Title = "📋 المطرودين" })
		local KickedList = RankTab:Paragraph({Title = "🚫", Desc = "..."})
		task.spawn(function()
			while true do
				task.wait(3)
				local list = {}
				for name, data in pairs(KICKED_USERS) do
					table.insert(list, "🚫 " .. name .. " — " .. tostring(data.reason))
				end
				pcall(function() KickedList:SetDesc(#list == 0 and "لا يوجد" or table.concat(list, "\n")) end)
			end
		end)

		RankTab:Button({
			Title = "✅ إلغاء طرد الكل",
			Icon = "check-circle",
			Callback = function()
				KICKED_USERS = {}
				saveKicked()
				notify("✅", "تم مسح قائمة المطرودين")
			end
		})

		RankTab:Divider()
		RankTab:Section({ Title = "🏆 فريق الإدارة" })
		RankTab:Paragraph({
			Title = "👑 AMT Team",
			Desc = "👑 Owner: ztjzfzjrh\n👑 Owner: tegrugjvd\n🛡️ CoOwner: Brooknoob_55\n⚫ BlackMark: 1KamRP"
		})
	end
end

