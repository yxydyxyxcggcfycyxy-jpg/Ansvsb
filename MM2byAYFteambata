task.spawn(function()
    while frame.Parent do
        task.wait(0.15)
        pcall(function()
            spdValue.Text = A.SpeedValue .. " studs"
            updateProgress()

            local rl = A.MyRole or "Unknown"
            local rc, rt = C_DIM, "IDLE"
            if A.RoundActive then
                if rl == "Murderer" then rc, rt = C_RED, "MURDERER"
                elseif rl == "Sheriff" then rc, rt = C_BLUE, "SHERIFF"
                elseif rl == "Innocent" then rc, rt = C_GREEN, "INNOCENT"
                else rc, rt = C_YELLOW, "PLAYING" end
            end
            roleText.Text = rt
            roleText.TextColor3 = rc
            roleBadge.BackgroundColor3 = rc
            roleStroke.Color = rc

            logoGlow.Transparency = 0.4 + math.abs(math.sin(tick() * 2)) * 0.3

            if SafeZoneActive then
                safeStroke.Transparency = 0.2 + math.abs(math.sin(tick() * 4)) * 0.3
                safeStroke.Thickness = 2
            else
                safeStroke.Transparency = 0.7
                safeStroke.Thickness = 1.2
            end

            -- Trade glow when active
            if A.AutoDeclineTrade then
                tradeStroke.Transparency = 0.3 + math.abs(math.sin(tick() * 3)) * 0.3
                tradeStroke.Thickness = 1.8
            else
                tradeStroke.Transparency = 0.7
                tradeStroke.Thickness = 1.2
            end

            if A.SafeZoneEnabled ~= lastToggleState then
                lastToggleState = A.SafeZoneEnabled
                applySafeToggle()
            end
            if A.AutoDeclineTrade ~= lastTradeState then
                lastTradeState = A.AutoDeclineTrade
                applyTradeToggle()
            end
            if FX.Enabled ~= lastFxState then
                lastFxState = FX.Enabled
                applyFxToggle()
            end

            if A.FarmEnabled then
                if SafeZoneActive then
                    farmBtn.Text = "🛡 SAFE"
                    farmGrad.Color = ColorSequence.new(C_GREEN, C_GREEN_D)
                    farmStroke.Color = C_GREEN
                    statusTxt.Text = "🛡 Safe under map"
                    statusTxt.TextColor3 = C_GREEN
                    statusDot.BackgroundColor3 = C_GREEN
                elseif not A.RoundActive then
                    farmBtn.Text = "⏸ WAIT"
                    farmGrad.Color = ColorSequence.new(C_YELLOW, Color3.fromRGB(200, 150, 30))
                    farmStroke.Color = C_YELLOW
                    statusTxt.Text = "Waiting for round..."
                    statusTxt.TextColor3 = C_YELLOW
                    statusDot.BackgroundColor3 = C_YELLOW
                else
                    farmBtn.Text = "⏹ STOP"
                    farmGrad.Color = ColorSequence.new(C_RED, C_RED_D)
                    farmStroke.Color = C_RED
                    statusTxt.Text = "✨ Farming"
                    statusTxt.TextColor3 = C_GREEN
                    statusDot.BackgroundColor3 = C_GREEN
                end
                farmStroke.Transparency = 0.3
            else
                farmBtn.Text = "▶  FARM"
                farmGrad.Color = ColorSequence.new(C_ACCENT, C_ACCENT2)
                farmStroke.Color = C_ACCENT2
                farmStroke.Transparency = 0.5
            end

            if A.KillEnabled then
                if not A.RoundActive then
                    killBtn.Text = "⏸ WAIT"
                    killGrad.Color = ColorSequence.new(Color3.fromRGB(120, 90, 20), Color3.fromRGB(80, 60, 15))
                    killStroke.Color = C_YELLOW
                elseif A.MyRole ~= "Murderer" then
                    killBtn.Text = "✕ NOT MURD"
                    killGrad.Color = ColorSequence.new(Color3.fromRGB(90, 40, 40), Color3.fromRGB(60, 20, 20))
                    killStroke.Color = C_RED
                elseif A.KillRequireFarm and not A.FarmEnabled then
                    killBtn.Text = "⚠ NEED FARM"
                    killGrad.Color = ColorSequence.new(C_YELLOW, Color3.fromRGB(180, 140, 20))
                    killStroke.Color = C_YELLOW
                elseif (A.CollectedCoins or 0) < (A.TargetCoins or 50) then
                    killBtn.Text = "⏳ " .. A.CollectedCoins .. "/" .. A.TargetCoins
                    killGrad.Color = ColorSequence.new(C_YELLOW, Color3.fromRGB(180, 140, 20))
                    killStroke.Color = C_YELLOW
                elseif A.KillNeedAllCoins and hasCoinsLeft() then
                    killBtn.Text = "⏳ FINISHING"
                    killGrad.Color = ColorSequence.new(C_YELLOW, Color3.fromRGB(180, 140, 20))
                    killStroke.Color = C_YELLOW
                elseif A.CurrentKillTarget then
                    killBtn.Text = "🔪 " .. A.CurrentKillTarget
                    killGrad.Color = ColorSequence.new(C_RED, C_RED_D)
                    killStroke.Color = C_RED
                else
                    killBtn.Text = "🔪 KILLING"
                    killGrad.Color = ColorSequence.new(C_RED, C_RED_D)
                    killStroke.Color = C_RED
                end
                killStroke.Transparency = 0.3
            else
                killBtn.Text = "🔪  KILL"
                killGrad.Color = ColorSequence.new(C_RED_D, Color3.fromRGB(80, 20, 20))
                killStroke.Color = C_RED
                killStroke.Transparency = 0.5
            end

            if not A.FarmEnabled and not A.KillEnabled and not SafeZoneActive then
                statusTxt.Text = "Ready"
                statusTxt.TextColor3 = C_MUTED
                statusDot.BackgroundColor3 = C_DIM
            end
        end)
    end
end)

