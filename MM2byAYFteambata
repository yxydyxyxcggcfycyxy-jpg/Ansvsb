local function verifyKey(key)
	if not httpRequest then return false, "No HTTP" end
	local ok, response = pcall(httpRequest, {
		Url = KF_VERIFY_URL, Method = "POST",
		Headers = {["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. KF_API_KEY},
		Body = HttpService:JSONEncode({
			project_id = KF_PROJECT_ID, key = key, hwid = HWID,
			roblox_user_id = LocalPlayer.UserId,
			roblox_username = LocalPlayer.Name,
		}),
	})
	if not ok or not response then return false, "Server error" end
	local decoded, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
	if not decoded or not data then return false, "Invalid" end
	return data.valid == true, data.message or "Unknown"
end

