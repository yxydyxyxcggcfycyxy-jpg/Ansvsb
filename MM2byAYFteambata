local function updateProgress()
    local cur = A.CollectedCoins or 0
    local tgt = math.max(A.TargetCoins or 50, 1)
    local ratio = math.clamp(cur / tgt, 0, 1)
    progCount.Text = cur .. " / " .. tgt
    progPercent.Text = math.floor(ratio * 100) .. "%"
    TS:Create(barFill, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {
        Size = UDim2.new(ratio, 0, 1, 0)
    }):Play()
    TS:Create(miniFill, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {
        Size = UDim2.new(ratio, 0, 1, 0)
    }):Play()
    if ratio >= 1 then
        barGrad.Color = ColorSequence.new(C_GREEN, Color3.fromRGB(100, 255, 160))
        miniGrad.Color = ColorSequence.new(C_GREEN, Color3.fromRGB(100, 255, 160))
        progPercent.TextColor3 = C_GREEN
    else
        barGrad.Color = ColorSequence.new(C_ACCENT, C_ACCENT2)
        miniGrad.Color = ColorSequence.new(C_ACCENT, C_ACCENT2)
        progPercent.TextColor3 = C_ACCENT
    end
end

