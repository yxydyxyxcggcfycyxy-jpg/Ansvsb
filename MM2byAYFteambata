local CoinCache={}
local CoinCacheTime=0
local function refreshCoinCache()
 CoinCache={}
 for _,v in pairs(WS:GetDescendants()) do
  if v:IsA("BasePart") and (v.Name=="Coin_Server" or v.Name=="Coin") and not CCO[v] then
   table.insert(CoinCache,v)
  end
 end
 CoinCacheTime=tick()
end
local function nearCoin(pos)
 if tick()-CoinCacheTime>3 or #CoinCache==0 then
  refreshCoinCache()
  if #CoinCache==0 then return nil end
 end
 local best,bestDist=nil,math.huge
 local newCache={}
 for _,v in ipairs(CoinCache) do
  if v and v.Parent and not CCO[v] then
   local d=(v.Position-pos).Magnitude
   if d<bestDist then bestDist=d best=v end
   table.insert(newCache,v)
  end
 end
 CoinCache=newCache
 return best
end
local function pullAll()
