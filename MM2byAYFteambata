local function updateESP()
	for player, obj in pairs(ESPObjects) do
		if not player.Parent then
			removeESP(player)
			continue
		end
		local char = player.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")
			local role = getRole(player)

			if _G.AMT.ESPPlayers then
				obj.highlight.Adornee = char
				obj.highlight.Enabled = true
				if _G.AMT.ESPRoles and role then
					local rc = getRoleColor(role)
					obj.highlight.FillColor = rc
					obj.highlight.OutlineColor = rc
				else
					obj.highlight.FillColor = Color3.fromRGB(200, 200, 200)
					obj.highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
				end
			else
				obj.highlight.Adornee = nil
				obj.highlight.Enabled = false
			end

			if _G.AMT.ESPPlayers and hrp then
				obj.billboard.Adornee = hrp
				obj.billboard.Enabled = true

				if _G.AMT.ESPNames then
					local rt = ""
					if _G.AMT.ESPRoles and role then
						if role == "Murderer" then rt = "🔪 "
						elseif role == "Sheriff" then rt = "🔫 "
						elseif role == "Innocent" then rt = "👤 "
						else rt = "❔ " end
					end
					obj.nameLabel.Text = rt .. player.Name
					obj.nameLabel.TextColor3 = (_G.AMT.ESPRoles and role) and getRoleColor(role) or Color3.fromRGB(255, 255, 255)
					obj.nameLabel.Visible = true
				else
					obj.nameLabel.Visible = false
				end

				local info = {}
				if _G.AMT.ESPHealth and hum then
					table.insert(info, "❤️ " .. math.floor(hum.Health))
				end
				if _G.AMT.ESPDistance and hrp then
					local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					if myHrp then
						table.insert(info, "📏 " .. math.floor((hrp.Position - myHrp.Position).Magnitude))
					end
				end
				if _G.AMT.ESPWeapons then
					local tool = char:FindFirstChildOfClass("Tool")
					if tool then table.insert(info, "🔧 " .. tool.Name) end
				end
				obj.infoLabel.Text = table.concat(info, " | ")
				obj.infoLabel.Visible = #info > 0
			else
				obj.billboard.Enabled = false
			end
		else
			if obj.highlight then
				obj.highlight.Adornee = nil
				obj.highlight.Enabled = false
			end
			if obj.billboard then obj.billboard.Enabled = false end
		end
	end
end

