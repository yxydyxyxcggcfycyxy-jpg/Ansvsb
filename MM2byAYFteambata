        if bp then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") then
                    local n = tool.Name:lower()
                    if n:find("knife") or n:find("sword") or n:find("blade") or n:find("dagger") then
                        pcall(function() h:EquipTool(tool) end)
                        task.wait(0.1)
                        return true
                    end
                end
            end
        end
    end)
    return false
end

-- ═══════════════════════════════════════════════════════════════
-- AUTO KILL
-- ═══════════════════════════════════════════════════════════════
local function killLoop()
    if KillLoopRunning then return end
    KillLoopRunning = true
    while A.KillEnabled do
        task.wait(0.15)
        if SafeZoneActive then task.wait(0.4) continue end
        if not A.RoundActive then task.wait(0.4) continue end
        local role = checkRoleFromTools()
        if role then A.MyRole = role end
        if A.MyRole ~= "Murderer" then task.wait(0.4) continue end
        if A.KillRequireFarm and not A.FarmEnabled then task.wait(0.4) continue end
        local target = A.TargetCoins or 50
        local current = A.CollectedCoins or 0
        if current < target then task.wait(0.3) continue end
        if A.KillNeedAllCoins and hasCoinsLeft() then task.wait(0.3) continue end
        local ch = LP.Character
        if not ch then task.wait(0.3) continue end
        local h = ch:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then task.wait(0.3) continue end
        local myRoot = ch:FindFirstChild("HumanoidRootPart")
        if not myRoot then task.wait(0.3) continue end
        equipKnife()
        task.wait(0.1)
        local captured = pullAllInFront()
        if #captured == 0 then task.wait(0.4) continue end
        A.CurrentKillTarget = "TARGETS(" .. #captured .. ")"
        if UiCallbacks.onKillStart then UiCallbacks.onKillStart() end
        for i = 1, (A.KillAttackCount or 25) do
            if not A.KillEnabled or not A.RoundActive then break end
            local alive = 0
            for _, c in ipairs(captured) do
                if c.hum and c.hum.Parent and c.hum.Health > 0 then alive = alive + 1 end
            end
            if alive == 0 then break end
            local tool = ch:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
            pcall(function()
                VU:CaptureController()
                VU:ClickButton1(Vector2.new(500, 500))
            end)
            task.wait(A.KillClickDelay or 0.05)
        end
        for _, c in ipairs(captured) do
            pcall(function()
                if c.hum then
                    c.hum.WalkSpeed = 16
                    c.hum.JumpPower = 50
                    c.hum.PlatformStand = false
                end
                if c.root then c.root.Anchored = false end
                if c.player and c.player.Character then
                    for _, pt in ipairs(c.player.Character:GetChildren()) do
                        if pt:IsA("BasePart") then pt.Anchored = false end
                    end
                end
            end)
        end
        A.CurrentKillTarget = nil
        task.wait(A.KillTargetDelay or 0.4)
    end
    KillLoopRunning = false
    A.CurrentKillTarget = nil
end

