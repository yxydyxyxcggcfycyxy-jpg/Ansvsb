-- 🔄 CHAT SYNC (Hex Encoded)
-- ═══════════════════════════════════════════════════════════════════════
local SyncChannel = nil
pcall(function()
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		SyncChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
	end
end)

local function toHex(str)
	return (str:gsub(".", function(c) return string.format("%02x", c:byte()) end))
end

local function fromHex(hex)
	return (hex:gsub("%x%x", function(cc) return string.char(tonumber(cc, 16)) end))
end

local HEX_PREFIX = "414d5453594e43"

local function broadcastSync(msg)
	pcall(function()
		local encoded = HEX_PREFIX .. toHex(msg)
		if SyncChannel then
			SyncChannel:SendAsync(encoded)
		else
			game:GetService("Chat"):Chat(LocalPlayer.Character, encoded)
		end
	end)
end

local function handleSyncMessage(msg)
	if not msg or type(msg) ~= "string" then return end
	if msg:sub(1, #HEX_PREFIX) == HEX_PREFIX then
		local okDec, decoded = pcall(function() return fromHex(msg:sub(#HEX_PREFIX + 1)) end)
		if not okDec or not decoded then return end
		msg = decoded
	end

	if msg:sub(1, 10) == "AMT_RANK::" then
		local target, rank = msg:match("^AMT_RANK::([^:]+)::(.+)$")
		if target and rank and RANK_DATA[rank] then
			RANKS[target] = rank
			saveRanks()
			local t = Players:FindFirstChild(target)
			if t then
				removeHeadTag(t)
				task.wait(0.1)
				createHeadTag(t)
			end
			if target == LocalPlayer.Name then
				updateMyRankVars(rank)
				notify("🎃 رتبتك تغيرت", "رتبتك الجديدة: " .. rank)
			end
		end
	end

	if msg:sub(1, 10) == "AMT_KICK::" then
		local target, reason = msg:match("^AMT_KICK::([^:]+)::(.+)$")
		if target and target == LocalPlayer.Name then
			KICKED_USERS[target] = {reason = reason or "من الإدارة", by = "Sync"}
			saveKicked()
			pcall(function() LocalPlayer:Kick("🎃 تم طردك\nالسبب: " .. (reason or "من الإدارة")) end)
		end
	end

	if msg:sub(1, 12) == "AMT_UNKICK::" then
		local target = msg:match("^AMT_UNKICK::(.+)$")
		if target then
			KICKED_USERS[target] = nil
			saveKicked()
			if target == LocalPlayer.Name then
				notify("✅ تم إلغاء طردك", "تقدر تستخدم السكربت الحين")
			end
		end
	end
end

local function hookPlayerChat(p)
	p.Chatted:Connect(function(msg) task.spawn(handleSyncMessage, msg) end)
end
for _, p in ipairs(Players:GetPlayers()) do hookPlayerChat(p) end
Players.PlayerAdded:Connect(hookPlayerChat)

