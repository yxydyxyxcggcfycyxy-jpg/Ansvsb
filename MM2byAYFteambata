-- 🎯 SMART TARGETING + AUTO FIGHT
-- ═══════════════════════════════════════════════════════════════
local function getTargets()
    local targets = {}
    if A.MyRole == "Sheriff" then
        for n, info in pairs(RoleData) do
            if info.Role == "Murderer" then
                local p = Players:FindFirstChild(n)
                if p and p ~= LP and p.Character then
                    local h = p.Character:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then table.insert(targets, p) end
                end
            end
        end
    elseif A.MyRole == "Murderer" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then table.insert(targets, p) end
            end
        end
    end
    return targets
end

local function findGun()
    local ch = LP.Character
    if not ch then return nil end
    local gun = ch:FindFirstChild("Gun")
    if gun then return gun end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("gun") or n:find("revolver") or n:find("pistol") then
                    return t
                end
            end
        end
    end
    return nil
end

