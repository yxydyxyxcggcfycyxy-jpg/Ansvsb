 local r=ch:FindFirstChild("HumanoidRootPart") if not r then return end
 local pos=r.Position lv=r.CFrame.LookVector rv=r.CFrame.RightVector i=0
 for _,p in ipairs(Players:GetPlayers()) do
  if p~=LP and p.Character then
   local tr=p.Character:FindFirstChild("HumanoidRootPart")
   if tr then
    local row=math.floor(i/4) col=i%4
    local tp=pos+(lv*(row*1.2+2))+(rv*((col-1.5)*1.2))
    pcall(function() tr.CFrame=CFrame.new(tp,pos) tr.Anchored=true local h=p.Character:FindFirstChildOfClass("Humanoid") if h then h.WalkSpeed=0 h.JumpPower=0 h.PlatformStand=true end for _,pt in ipairs(p.Character:GetChildren()) do if pt:IsA("BasePart") then pt.Anchored=true end end end)
    i=i+1
   end
  end
 end
end
