-- VELOCITY GUARD (يعمل فقط في الجولة)
-- ═══════════════════════════════════════════════════════════════
local function startVG()
    if VelGuard then VelGuard:Disconnect() end
    VelGuard = RUN.Heartbeat:Connect(function()
        if not A.RoundActive then return end
        local ch = LP.Character
        local r = ch and ch:FindFirstChild("HumanoidRootPart")
        if r and not r.Anchored then
            pcall(function()
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end)
end
local function stopVG()
    if VelGuard then VelGuard:Disconnect() VelGuard = nil end
end

-- ═══════════════════════════════════════════════════════════════
-- FARM LOOP — Armed anytime، يتحرك فقط في الجولة
-- ═══════════════════════════════════════════════════════════════
local function farmLoop()
    while A.AutoEnabled do
        task.wait(0.05)

        -- لوبي: انتظار بدون حركة
        if not A.RoundActive then
            if VelGuard then stopVG() end
            if CurTween then CurTween:Cancel() CurTween = nil end
            FarmBaseY = nil
            task.wait(0.5)
            continue
        end

        if not VelGuard then startVG() end

        local ch = LP.Character
        local r = ch and ch:FindFirstChild("HumanoidRootPart")
        local h = ch and ch:FindFirstChildOfClass("Humanoid")

        if not r or not h or h.Health <= 0 or tick() - LastRespawn < 3 then
            if CurTween then CurTween:Cancel() CurTween = nil end
            FarmBaseY = nil
            task.wait(0.4)
            continue
        end

        if not FarmBaseY then
            local rc = RaycastParams.new()
            rc.FilterType = Enum.RaycastFilterType.Exclude
            rc.FilterDescendantsInstances = { ch, Plat }
            local hit = workspace:Raycast(r.Position, Vector3.new(0, -5000, 0), rc)
            if hit then
                FarmBaseY = math.min(hit.Position.Y - 8, r.Position.Y - 3)
            else
                FarmBaseY = r.Position.Y - 20
            end
        end

        local sp = math.clamp(A.SpeedValue or 35, 5, 100)
        local tc = nearCoin(r.Position)

        if not (tc and tc.Parent) then
            if math.abs(r.Position.Y - FarmBaseY) > 0.5 then
                if CurTween then CurTween:Cancel() end
                CurTween = TS:Create(r, TweenInfo.new(0.2, Enum.EasingStyle.Linear),
                    { CFrame = CFrame.new(r.Position.X, FarmBaseY, r.Position.Z) })
                CurTween:Play()
            end
            task.wait(0.12)
            continue
        end

        local under = Vector3.new(tc.Position.X, FarmBaseY, tc.Position.Z)
        local STEPS = {
            { pos = under, spd = sp, touch = false },
            { pos = tc.Position, spd = sp * 2, touch = true },
            { pos = under, spd = sp * 2, touch = false },
        }

        for _, s in ipairs(STEPS) do
            if not A.AutoEnabled or not isAlive() or not A.RoundActive then break end
            local d = (r.Position - s.pos).Magnitude
            local dur = math.max(0.05, d / s.spd)
            if CurTween then CurTween:Cancel() end
            CurTween = TS:Create(r, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = CFrame.new(s.pos) })
            CurTween:Play()
            task.wait(dur + 0.01)

            if s.touch and tc and tc.Parent then
                local before = A.CollectedCoins or 0
                pcall(function()
                    firetouchinterest(r, tc, 0)
                    firetouchinterest(r, tc, 1)
                end)
                CCO[tc] = true
                task.wait(0.03)
                if tc and tc.Parent and (A.CollectedCoins or 0) == before then
                    FailedCoins[tc] = true
                end
            end
        end
    end
    stopVG()
end

