local function decodeMsgResponse(res)
	if not res then return nil end
	local okJ, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
	if not okJ then return nil end
	if res.StatusCode and res.StatusCode >= 400 then return nil end
	return data
end

local function sendSupport(text, callback)
	if not httpRequest then
		if callback then callback(false, nil) end
		return
	end
	task.spawn(function()
		local ok, res = pcall(httpRequest, {
			Url = KF_MSG_URL, Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["Authorization"] = "Bearer " .. KF_API_KEY,
			},
			Body = HttpService:JSONEncode({
				project_id = KF_PROJECT_ID,
				player_user_id = LocalPlayer.UserId,
				player_name = LocalPlayer.Name,
				message = text,
			}),
		})
		if not ok then if callback then callback(false, nil) end return end
		local data = decodeMsgResponse(res)
		if not data then if callback then callback(false, nil) end return end
		if callback then callback(true, data) end
	end)
end

local function pollReplies()
	if not httpRequest then return end
	local url = KF_MSG_URL .. "?project_id=" .. KF_PROJECT_ID .. "&player_user_id=" .. LocalPlayer.UserId
	if lastSeen then url = url .. "&since=" .. HttpService:UrlEncode(lastSeen) end
	local ok, res = pcall(httpRequest, {
		Url = url, Method = "GET",
		Headers = { ["Authorization"] = "Bearer " .. KF_API_KEY },
	})
	if not ok then return end
	local data = decodeMsgResponse(res)
	if not data then return end
	for _, m in ipairs(data.messages or {}) do
		lastSeen = m.created_at
	end
	primed = true
end

