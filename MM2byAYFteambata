 local o,r=pcall(httpReq,{Url=u,Method="GET",Headers={["Accept"]="text/plain"}})
 if not o or not r or not r.Body then return nil end
 if #r.Body<3 then return nil end
 local x=tostring(r.Body) if hB(x) then return nil end return x
end
