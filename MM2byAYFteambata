					obj.nameLabel.TextColor3 = (_G.AMT.ESPRoles and role) and getRoleColor(role) or Color3.fromRGB(255, 255, 255)
					obj.nameLabel.Visible = true
				else
					obj.nameLabel.Visible = false
				end

				local info = {}
				if _G.AMT.ESPHealth and hum then table.insert(info, "❤️ " .. math.floor(hum.Health)) end
				if _G.AMT.ESPDistance and hrp then
					local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					if myHrp then table.insert(info, "📏 " .. math.floor((hrp.Position - myHrp.Position).Magnitude)) end
				end
				if _G.AMT.ESPWeapons then
					local tool = char:FindFirstChildOfClass("Tool")
