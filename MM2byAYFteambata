-- ANTI-KICK
-- ═══════════════════════════════════════════════════════════════
local AntiKickLog = {}
local function logKick(src)
    A.KickBlocked = (A.KickBlocked or 0) + 1
    table.insert(AntiKickLog, { t = tick(), src = src })
    if #AntiKickLog > 30 then table.remove(AntiKickLog, 1) end
end
local function setupAntiKick()
    pcall(function() LP.Kick = function() logKick("Player:Kick") end end)
    pcall(function()
        local oldPK = Players.Kick
        Players.Kick = function(self, plr, ...)
            if plr == LP then logKick("Players:Kick") return end
            return oldPK(self, plr, ...)
        end
    end)
    if hookmetamethod and getnamecallmethod then
        pcall(function()
            local oldNC
            oldNC = hookmetamethod(game, "__namecall", function(self, ...)
                if not A.AntiKickEnabled then return oldNC(self, ...) end
                local m = getnamecallmethod()
                if m == "Kick" then
                    if self == LP then logKick("nc:Kick") return end
                    local a1 = ...
                    if self == Players and a1 == LP then logKick("nc:PK") return end
                elseif m == "Destroy" then
                    if self == LP then logKick("nc:Destroy") return end
                end
                return oldNC(self, ...)
            end)
        end)
    end
    pcall(function()
        RUN.Heartbeat:Connect(function()
            if not A.AntiKickEnabled then return end
            local ch = LP.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Position.Y < -500 then
                pcall(function() hrp.CFrame = CFrame.new(0, 50, 0) end)
            end
        end)
    end)
end
setupAntiKick()

