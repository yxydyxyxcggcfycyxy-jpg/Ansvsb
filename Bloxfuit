-- ===== العد التنازلي =====
local TimeLeft = 10
local TotalTime = 10

spawn(function()
    for i = TimeLeft, 0, -1 do
        if not ScreenGui.Parent then break end
        CountdownLabel.Text = "الحظر خلال: " .. i
        
        -- صوت تنبيه
        pcall(function()
            local Sound = Instance.new("Sound")
            Sound.SoundId = "rbxassetid://131961136"
            Sound.Volume = 0.5
            Sound.Parent = ScreenGui
            Sound:Play()
            game:GetService("Debris"):AddItem(Sound, 2)
        end)
        
        -- تقليل شريط التقدم
        local tween = game:GetService("TweenService"):Create(
            ProgressBar,
            TweenInfo.new(0.9, Enum.EasingStyle.Linear),
            {Size = UDim2.new((i - 1) / TotalTime, 0, 1, 0)}
        )
        tween:Play()
        
        wait(1)
    end
    
    -- انتهى العد
    if ScreenGui.Parent then
        WarningText.Text = "🚫 تم حظر الحساب والجهاز 🚫"
        CountdownLabel.Text = "تم الحظر بنجاح"
        CountdownLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        ShakeIntensity = 1.5
        
        wait(3)
        Shaking = false
        ScreenGui:Destroy()
    end
end)

