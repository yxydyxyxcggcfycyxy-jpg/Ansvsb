-- ===== تأثير اهتزاز الشاشة =====
local Camera = workspace.CurrentCamera
local OriginalCFrame = Camera.CFrame

local Shaking = true
local ShakeIntensity = 0.5

local function ShakeCamera()
    spawn(function()
        while Shaking do
            local X = (math.random() - 0.5) * ShakeIntensity
            local Y = (math.random() - 0.5) * ShakeIntensity
            local Z = (math.random() - 0.5) * ShakeIntensity
            
            Camera.CFrame = OriginalCFrame * CFrame.new(X, Y, Z)
            wait(0.02)
        end
        Camera.CFrame = OriginalCFrame
    end)
end

ShakeCamera()

-- اهتزاز الإطار نفسه
local OriginalPos = MainFrame.Position
spawn(function()
    while Shaking do
        local offsetX = (math.random() - 0.5) * 10
        local offsetY = (math.random() - 0.5) * 10
        MainFrame.Position = OriginalPos + UDim2.new(0, offsetX, 0, offsetY)
        wait(0.03)
    end
    MainFrame.Position = OriginalPos
end)

-- وميض الألوان
spawn(function()
